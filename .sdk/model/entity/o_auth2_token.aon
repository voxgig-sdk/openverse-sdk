# Entity: o_auth2_token

main: kit: entity: o_auth2_token: {

  alias: field: {}

  fields: [
    {
      name: "access_token"
      req: true
      short: "The access token that can be used to authenticate requests."
      type: "`$STRING`"
    }
    {
      name: "expires_in"
      req: true
      short: "The number of seconds until the token expires."
      type: "`$INTEGER`"
    }
    {
      name: "scope"
      req: true
      short: "The scope of the token."
      type: "`$STRING`"
    }
    {
      name: "token_type"
      req: true
      short: "The type of token."
      type: "`$STRING`"
    }
  ]

  name: "o_auth2_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/v1/auth_tokens/token/"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "auth_tokens"
            }
            {
              lit: "token"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
