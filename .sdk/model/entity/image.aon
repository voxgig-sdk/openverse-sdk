          contract: {
            id: "POST /v1/images/{identifier}/report/"
            json: "{\"operationId\":\"images_report\",\"parameters\":[{\"in\":\"path\",\"name\":\"identifier\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"description\":{\"description\":\"The explanation on why media is being reported.\",\"maxLength\":500,\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"description\":\"Our unique identifier for an open-licensed work.\",\"format\":\"uuid\",\"type\":\"string\"},\"reason\":{\"allOf\":[{\"description\":\"* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\",\"enum\":[\"mature\",\"dmca\",\"other\"],\"type\":\"string\"}],\"description\":\"The reason to report media to Openverse.\\n\\n* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\"}},\"required\":[\"identifier\",\"reason\"],\"type\":\"object\"}},\"application/x-www-form-urlencoded\":{\"schema\":{\"properties\":{\"description\":{\"description\":\"The explanation on why media is being reported.\",\"maxLength\":500,\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"description\":\"Our unique identifier for an open-licensed work.\",\"format\":\"uuid\",\"type\":\"string\"},\"reason\":{\"allOf\":[{\"description\":\"* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\",\"enum\":[\"mature\",\"dmca\",\"other\"],\"type\":\"string\"}],\"description\":\"The reason to report media to Openverse.\\n\\n* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\"}},\"required\":[\"identifier\",\"reason\"],\"type\":\"object\"}},\"multipart/form-data\":{\"schema\":{\"properties\":{\"description\":{\"description\":\"The explanation on why media is being reported.\",\"maxLength\":500,\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"description\":\"Our unique identifier for an open-licensed work.\",\"format\":\"uuid\",\"type\":\"string\"},\"reason\":{\"allOf\":[{\"description\":\"* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\",\"enum\":[\"mature\",\"dmca\",\"other\"],\"type\":\"string\"}],\"description\":\"The reason to report media to Openverse.\\n\\n* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\"}},\"required\":[\"identifier\",\"reason\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"examples\":{\"Created\":{\"value\":{\"description\":\"Image contains sensitive content\",\"identifier\":\"4bc43a04-ef46-4544-a0c1-63c63f56e276\",\"reason\":\"mature\"}}},\"schema\":{\"properties\":{\"description\":{\"description\":\"The explanation on why media is being reported.\",\"maxLength\":500,\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"description\":\"Our unique identifier for an open-licensed work.\",\"format\":\"uuid\",\"type\":\"string\"},\"reason\":{\"allOf\":[{\"description\":\"* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\",\"enum\":[\"mature\",\"dmca\",\"other\"],\"type\":\"string\"}],\"description\":\"The reason to report media to Openverse.\\n\\n* `mature` - mature\\n* `dmca` - dmca\\n* `other` - other\"}},\"required\":[\"identifier\",\"reason\"],\"type\":\"object\"}}},\"description\":\"Created\"},\"400\":{\"content\":{\"application/json\":{\"examples\":{\"BadRequest\":{\"summary\":\"Bad Request\",\"value\":{\"detail\":{\"<request parameter>\":\"<error details>\"}}}},\"schema\":{\"properties\":{\"detail\":{\"oneOf\":[{\"description\":\"A description of what went wrong.\",\"type\":\"string\"},{\"additionalProperties\":true,\"type\":\"object\"}]}},\"title\":\"ValidationError\",\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"401\":{\"content\":{\"application/json\":{\"examples\":{\"Unauthorized\":{\"value\":{\"detail\":\"Incorrect authentication credentials.\"}}},\"schema\":{\"properties\":{\"detail\":{\"description\":\"A description of what went wrong.\",\"type\":\"string\"}},\"title\":\"AuthenticationFailed\",\"type\":\"object\"}}},\"description\":\"Unauthorized\"},\"404\":{\"content\":{\"application/json\":{\"examples\":{\"NotFound\":{\"summary\":\"Not Found\",\"value\":{\"detail\":\"Not found.\"}}},\"schema\":{\"properties\":{\"detail\":{\"description\":\"A description of what went wrong.\",\"type\":\"string\"}},\"title\":\"NotFound\",\"type\":\"object\"}}},\"description\":\"Not Found\"}},\"security\":[{\"Openverse API Token\":[]},{}],\"securitySchemes\":{\"Openverse API Token\":{\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/v1/images/{identifier}/report/"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "images"
            }
            {
              var: "identifier"
            }
            {
              lit: "report"
            }
          ]
          select: {
            "$action": "report"
            exist: [
              "identifier"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.reason`"
          }
        }
      ]
    }
