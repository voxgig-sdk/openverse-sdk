                name: "unstable_include_sensitive_result"
                orig: "unstable_include_sensitive_result"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "relevance"
                kind: "query"
                name: "unstable_sort_by"
                orig: "unstable_sort_by"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "desc"
                kind: "query"
                name: "unstable_sort_dir"
                orig: "unstable_sort_dir"
                reqd: false
                type: "`$STRING`"
